# PROCESS CHUNKS

all_final_segments = []
all_final_word_segments = []
detected_language = result.get("language")
align_model = None
metadata = None

for chunk_idx, (chunk_start, chunk_end) in enumerate(chunk_ranges):
    print(f"\n📦 Processing chunk {chunk_idx + 1}/{len(chunk_ranges)}: {chunk_start:.2f}s -> {chunk_end:.2f}s")

    chunk_audio = slice_audio(audio, chunk_start, chunk_end, SAMPLE_RATE)
    if len(chunk_audio) == 0:
        continue

    # 1. TRANSCRIBE CHUNK
    local_result = model.transcribe(chunk_audio, batch_size=batch_size, language=detected_language)
    if detected_language is None:
        detected_language = local_result.get("language")
        print(f"🌍 Detected language: {detected_language}")

    # 2. ALIGN CHUNK
    if align_model is None:
        print("🔧 Loading alignment model...")
        align_model, metadata = whisperx.load_align_model(language_code=detected_language, device=device)

    align_output = whisperx.align(
        local_result.get("segments", []),
        align_model,
        metadata,
        chunk_audio,
        device,
        return_char_alignments=False
    )
    local_result["segments"] = align_output["segments"]
    if "word_segments" in align_output:
        local_result["word_segments"] = align_output["word_segments"]

    # 3. DIARIZE CHUNK
    print("👂 Running diarization...")
    diarization_output = diarize_model(
        chunk_audio,
        min_speakers=DIAR_MIN_SPEAKERS,
        max_speakers=DIAR_MAX_SPEAKERS
    )

    diarize_df = convert_diarization_output_to_df(diarization_output)

    if diarize_df.empty:
        print("⚠️ No diarization segments found in this chunk.")
        shifted_result = shift_result_timestamps(local_result, chunk_start)
        all_final_segments.extend(shifted_result["segments"])
        all_final_word_segments.extend(shifted_result["word_segments"])
        continue

    # 4. BUILD LOCAL EMBEDDINGS
    local_embeddings = extract_local_speaker_embeddings(diarize_df, chunk_audio, speaker_encoder)

    # Fallback: if a local speaker got no embedding, preserve it with a new global ID
    local_speakers = list(diarize_df["speaker"].unique())
    local_to_global = {}

    if local_embeddings:
        local_to_global = match_local_speakers_to_global(local_embeddings)

    for local_spk in local_speakers:
        if local_spk not in local_to_global:
            new_global_id = get_next_global_speaker_id(list(speaker_blueprints.keys()) + list(local_to_global.values()))
            local_to_global[local_spk] = new_global_id
            print(f"🆕 Fallback global speaker created: {local_spk} -> {new_global_id}")

    # 5. RELABEL LOCAL DIARIZATION WITH GLOBAL IDs
    diarize_df = relabel_diarization_df_to_global(diarize_df, local_to_global)

    # 6. ASSIGN WORD SPEAKERS
    local_result = whisperx.assign_word_speakers(diarize_df, local_result)

    # 7. CLEAN RANDOM LABELS AGAINST GLOBAL DIARIZATION
    print("🔍 Running Speaker Alignment (Cleaning labels)...")
    M_labels = set()
    for segment in local_result["segments"]:
        for word in segment.get("words", []):
            if "speaker" in word:
                M_labels.add(word["speaker"])

    label_mapping_table = {}
    for M_label in M_labels:
        if str(M_label).startswith("SPEAKER_"):
            label_mapping_table[M_label] = M_label
            continue

        overlaps = []
        for segment in local_result["segments"]:
            for word in segment.get("words", []):
                if word.get("speaker") == M_label:
                    w_s, w_e = word["start"], word["end"]
                    matches = diarize_df[(diarize_df["start"] < w_e) & (diarize_df["end"] > w_s)]
                    if not matches.empty:
                        overlaps.extend(matches["speaker"].tolist())

        if overlaps:
            label_mapping_table[M_label] = Counter(overlaps).most_common(1)[0][0]
        else:
            label_mapping_table[M_label] = "Unknown"

    for segment in local_result["segments"]:
        valid_segment_speakers = []
        for word in segment.get("words", []):
            original_label = word.get("speaker")
            fixed_label = label_mapping_table.get(original_label, "Unknown")
            word["speaker"] = fixed_label
            if fixed_label != "Unknown":
                valid_segment_speakers.append(fixed_label)

        if valid_segment_speakers:
            segment["speaker"] = Counter(valid_segment_speakers).most_common(1)[0][0]

    # 8. SHIFT TO ABSOLUTE TIMES
    shifted_result = shift_result_timestamps(local_result, chunk_start)

    # 9. REMOVE DUPLICATES FROM OVERLAP
    if chunk_idx == 0:
        kept_segments = shifted_result["segments"]
    else:
        overlap_cutoff = chunk_start + (CHUNK_OVERLAP_SECONDS / 2.0)
        kept_segments = deduplicate_overlap_segments(shifted_result["segments"], overlap_cutoff)

    all_final_segments.extend(kept_segments)
    all_final_word_segments.extend(shifted_result["word_segments"])

    # 10. CHECKPOINT
    stage = 3
    save_checkpoint(
        stage_val=stage,
        language_val=detected_language,
        segments_val=all_final_segments,
        word_segments_val=all_final_word_segments,
        last_printed_val=last_printed,
        blueprints_val=speaker_blueprints
    )
    print(f"📦 Checkpoint saved after chunk {chunk_idx + 1}")

# Final result
result = {
    "language": detected_language,
    "segments": all_final_segments,
    "word_segments": all_final_word_segments
}

# PERIODIC CHECKPOINT DURING PRINTING
auto_checkpoint = time.time()

# PRINT AND BUILD READABLE TRANSCRIPT
print("🎤 Final transcript:")
with open(transcript_path, "w") as tf:
    segments = result.get("segments", [])
    for idx in range(last_printed, len(segments)):
        segment = segments[idx]
        start = segment.get("start", 0)
        end = segment.get("end", 0)
        speaker_id = segment.get("speaker", "Unknown")
        speaker = speaker_map.get(speaker_id, speaker_id)
        text = segment.get("text", "").strip()
        line = f"[{start:.2f}-{end:.2f}] {speaker}: {text}"
        print(line)
        tf.write(f"{line}\n")
        last_printed += 1

        if time.time() - auto_checkpoint > checkpoint_interval:
            save_checkpoint(
                stage_val=stage,
                language_val=result.get("language"),
                segments_val=segments,
                word_segments_val=result.get("word_segments", []),
                last_printed_val=last_printed,
                blueprints_val=speaker_blueprints
            )
            print(f"📅 Auto-checkpoint at segment {idx}")
            auto_checkpoint = time.time()

# FINAL SAVE
save_checkpoint(
    stage_val=stage,
    language_val=result.get("language"),
    segments_val=result.get("segments", []),
    word_segments_val=result.get("word_segments", []),
    last_printed_val=last_printed,
    blueprints_val=speaker_blueprints
)

print(f"📄 Transcript saved to {transcript_path}")

