# HELPERS

def cosine_similarity(a: np.ndarray, b: np.ndarray) -> float:
    a_norm = np.linalg.norm(a) + 1e-8
    b_norm = np.linalg.norm(b) + 1e-8
    return float(np.dot(a, b) / (a_norm * b_norm))

def normalize_embedding(vec: np.ndarray) -> np.ndarray:
    return vec / (np.linalg.norm(vec) + 1e-8)

def get_next_global_speaker_id(existing_ids: List[str]) -> str:
    nums = []
    for spk in existing_ids:
        if str(spk).startswith("SPEAKER_"):
            try:
                nums.append(int(str(spk).split("_")[1]))
            except Exception:
                pass
    next_num = max(nums) + 1 if nums else 0
    return f"SPEAKER_{next_num:02d}"

def save_checkpoint(stage_val, language_val, segments_val, word_segments_val, last_printed_val, blueprints_val):
    serializable_blueprints = {}
    for spk_id, info in blueprints_val.items():
        serializable_blueprints[spk_id] = {
            "centroid": info["centroid"].tolist(),
            "count": info.get("count", 1)
        }

    cp_data = {
        "stage": stage_val,
        "language": language_val,
        "segments": segments_val,
        "word_segments": word_segments_val,
        "last_printed": last_printed_val,
        "speaker_blueprints": serializable_blueprints
    }
    with open(checkpoint_path, "w") as f:
        json.dump(cp_data, f, indent=2)

def get_chunk_ranges(total_seconds: float, chunk_seconds: int, overlap_seconds: int) -> List[Tuple[float, float]]:
    ranges = []
    step = chunk_seconds - overlap_seconds
    if step <= 0:
        raise ValueError("CHUNK_SECONDS must be greater than CHUNK_OVERLAP_SECONDS.")
    current_start = 0.0
    while current_start < total_seconds:
        current_end = min(total_seconds, current_start + chunk_seconds)
        ranges.append((current_start, current_end))
        if current_end >= total_seconds:
            break
        current_start += step
    return ranges

def slice_audio(audio_array: np.ndarray, start_sec: float, end_sec: float, sr: int = SAMPLE_RATE) -> np.ndarray:
    s = max(0, int(start_sec * sr))
    e = min(len(audio_array), int(end_sec * sr))
    return audio_array[s:e]

def convert_diarization_output_to_df(diarization_output) -> pd.DataFrame:
    if hasattr(diarization_output, "itertracks"):
        diarize_segments = [
            {"start": t.start, "end": t.end, "speaker": s}
            for t, _, s in diarization_output.itertracks(yield_label=True)
        ]
    else:
        diarize_segments = diarization_output.to_dict("records")

    diarize_df = pd.DataFrame(diarize_segments)
    if diarize_df.empty:
        return pd.DataFrame(columns=["start", "end", "speaker"])

    diarize_df = diarize_df.sort_values(["start", "end"]).reset_index(drop=True)
    return diarize_df

def shift_result_timestamps(local_result: Dict[str, Any], offset_sec: float) -> Dict[str, Any]:
    shifted = {"language": local_result.get("language"), "segments": [], "word_segments": []}

    for segment in local_result.get("segments", []):
        seg = dict(segment)
        if "start" in seg:
            seg["start"] = float(seg["start"]) + offset_sec
        if "end" in seg:
            seg["end"] = float(seg["end"]) + offset_sec

        words_out = []
        for word in seg.get("words", []):
            w = dict(word)
            if "start" in w:
                w["start"] = float(w["start"]) + offset_sec
            if "end" in w:
                w["end"] = float(w["end"]) + offset_sec
            words_out.append(w)
            shifted["word_segments"].append(w)

        seg["words"] = words_out
        shifted["segments"].append(seg)

    return shifted

def update_blueprint(global_id: str, embedding: np.ndarray):
    global speaker_blueprints

    if global_id not in speaker_blueprints:
        speaker_blueprints[global_id] = {
            "centroid": normalize_embedding(embedding),
            "count": 1
        }
        return

    old_centroid = speaker_blueprints[global_id]["centroid"]
    new_centroid = normalize_embedding(
        (1.0 - BLUEPRINT_UPDATE_ALPHA) * old_centroid + BLUEPRINT_UPDATE_ALPHA * embedding
    )
    speaker_blueprints[global_id]["centroid"] = new_centroid
    speaker_blueprints[global_id]["count"] += 1

def extract_local_speaker_embeddings(
    diarize_df: pd.DataFrame,
    chunk_audio: np.ndarray,
    encoder
) -> Dict[str, np.ndarray]:
    """
    Build one embedding per local diarized speaker from several usable spans.
    """
    local_embeddings = {}

    for local_spk in diarize_df["speaker"].unique():
        speaker_rows = diarize_df[diarize_df["speaker"] == local_spk].copy()
        speaker_rows["duration"] = speaker_rows["end"] - speaker_rows["start"]
        speaker_rows = speaker_rows[speaker_rows["duration"] >= MIN_EMBED_SEGMENT_SEC]
        speaker_rows = speaker_rows.sort_values("duration", ascending=False)

        candidate_embeddings = []
        for _, row in speaker_rows.head(MAX_EMBED_SEGMENTS_PER_LOCAL_SPK).iterrows():
            s = float(row["start"])
            e = float(row["end"])
            clip = slice_audio(chunk_audio, s, e, SAMPLE_RATE)
            if len(clip) < int(MIN_EMBED_SEGMENT_SEC * SAMPLE_RATE):
                continue

            wav = torch.tensor(clip, dtype=torch.float32).unsqueeze(0)
            with torch.no_grad():
                emb = encoder.encode_batch(wav)

            emb = emb.squeeze().detach().cpu().numpy()
            emb = normalize_embedding(emb)
            candidate_embeddings.append(emb)

        if candidate_embeddings:
            avg_emb = normalize_embedding(np.mean(np.stack(candidate_embeddings), axis=0))
            local_embeddings[local_spk] = avg_emb

    return local_embeddings

def match_local_speakers_to_global(
    local_embeddings: Dict[str, np.ndarray]
) -> Dict[str, str]:
    """
    Match local chunk speakers to persistent global speakers using cosine similarity.
    If no match is strong enough, create a new global speaker ID.
    """
    local_to_global = {}
    used_global_ids = set()

    for local_spk, emb in local_embeddings.items():
        best_global_id = None
        best_score = -1.0

        for global_id, info in speaker_blueprints.items():
            if global_id in used_global_ids:
                continue
            score = cosine_similarity(emb, info["centroid"])
            if score > best_score:
                best_score = score
                best_global_id = global_id

        if best_global_id is not None and best_score >= BLUEPRINT_MATCH_THRESHOLD:
            local_to_global[local_spk] = best_global_id
            used_global_ids.add(best_global_id)
            update_blueprint(best_global_id, emb)
            print(f"🔗 Matched local {local_spk} -> {best_global_id} (score={best_score:.3f})")
        else:
            new_global_id = get_next_global_speaker_id(list(speaker_blueprints.keys()) + list(local_to_global.values()))
            local_to_global[local_spk] = new_global_id
            used_global_ids.add(new_global_id)
            update_blueprint(new_global_id, emb)
            print(f"🆕 New global speaker created: {local_spk} -> {new_global_id}")

    return local_to_global

def relabel_diarization_df_to_global(diarize_df: pd.DataFrame, local_to_global: Dict[str, str]) -> pd.DataFrame:
    diarize_df = diarize_df.copy()
    diarize_df["speaker"] = diarize_df["speaker"].map(lambda x: local_to_global.get(x, x))
    return diarize_df

def deduplicate_overlap_segments(all_segments: List[Dict[str, Any]], overlap_start_cutoff: float) -> List[Dict[str, Any]]:
    """
    Remove duplicated chunk-overlap segments by keeping only segments whose midpoint is past overlap cutoff.
    """
    filtered = []
    for seg in all_segments:
        midpoint = (float(seg.get("start", 0)) + float(seg.get("end", 0))) / 2.0
        if midpoint >= overlap_start_cutoff:
            filtered.append(seg)
    return filtered

